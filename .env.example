# Local Compose development only. Copy to .env; exports take precedence.
APP_ENV=development
DATABASE_URL=postgres://archive:archive_local@127.0.0.1:5432/archive
LISTEN_ADDR=127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
IMAGE_STORAGE_DIR=./var/images
RUST_LOG=the_archive=info,tower_http=info
MAINTENANCE_MODE=false

# Optional Librarian Clerk integration. Runtime needs no bot token.
DISCORD_ENABLED=false
# DISCORD_APPLICATION_ID=<application-id>
# DISCORD_PUBLIC_KEY=<64-hex-character-portal-public-key>
# DISCORD_GUILD_ID=<private-server-id>
# DISCORD_ALLOWED_USER_IDS=<first-user-id>,<second-user-id>
# DISCORD_BOT_TOKEN=<private-registration-only-token>  (prefer hidden prompt; remove after registration)
# See docs/DISCORD.md for owner-only portal, install and registration steps.

# Railway: supply real values in the service Variables UI, never commit them.
# APP_ENV=production
# DATABASE_URL=postgresql://<user>:<password>@<direct-neon-host>/<database>?sslmode=verify-full
# APP_ORIGIN=https://<your-service-domain>        (no path/query/credentials)
# PORT=3000                                   (Railway health-check port; app uses LISTEN_ADDR)
# LISTEN_ADDR=0.0.0.0:3000                       (target port 3000; no $PORT expansion)
# IMAGE_STORAGE_DIR=/data/images                (persistent volume at /data)
# RAILWAY_RUN_UID=0                             (entrypoint initializes permissions, then drops to UID 10001)
# MAINTENANCE_MODE=true                         (pause app writes for backup/import; health remains live)
# No signing secret: opaque session digests are stored in PostgreSQL.
